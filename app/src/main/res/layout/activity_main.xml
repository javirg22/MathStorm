<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/AppBackground">

    <TextView
        android:id="@+id/Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Title_MainPage"
        android:textSize="50sp"
        android:layout_marginTop="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:id="@+id/FirstUnderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/UnderTitle_MainPage"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/Title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:id="@+id/SecondUnderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/SecondUnderTitle_MainPage"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/FirstUnderTitle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <Button
        android:id="@+id/LearnButton"
        android:layout_width="250dp"
        android:layout_height="250dp"
        style="@style/button"
        android:backgroundTint="@color/ButtonBackground"
        android:text="@string/FirstButtonText_MainPage"
        android:onClick="openExamples"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/SecondUnderTitle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />

    <!--<androidx.cardview.widget.CardView
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:backgroundTint="@color/ButtonBackground"
        android:text="@string/SecondButtonText_MainPage"
        app:cardCornerRadius="20dp"

        app:layout_constraintTop_toBottomOf="@id/LearnButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginBottom="60dp"
        >

    </androidx.cardview.widget.CardView>
    -->
    <Button
        android:gravity="center"
        android:id="@+id/ExerciseButton"
        android:layout_width="250dp"
        android:layout_height="250dp"
        style="@style/button"

        android:backgroundTint="@color/ButtonBackground"
        android:text="@string/SecondButtonText_MainPage"
        android:onClick="openPrueba"
        app:layout_constraintTop_toBottomOf="@id/LearnButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginBottom="60dp"
        >

    </Button>

</androidx.constraintlayout.widget.ConstraintLayout>